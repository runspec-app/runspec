/* runspec-tui — layout and the Forms-view look. Colours come from the active
   Textual theme ($primary, $panel, …) so every theme works. */

#body { height: 1fr; }

#sidebar {
    width: 38;
    border-right: tall $panel;
    padding: 1 0 0 0;
}
#search { margin: 0 1 1 1; }
#runnables { height: 1fr; border: none; background: transparent; }
#count { padding: 0 2; height: 1; }

#main { height: 1fr; }
#pane { height: 1fr; padding: 1 2; }
#help {
    height: auto;
    max-height: 4;
    padding: 0 2;
    background: $panel;
    display: none;
}

#crumbs { margin-bottom: 1; }
#description { color: $text-muted; margin-bottom: 1; }
#welcome { padding: 2 4; }

.section {
    color: $text-muted;
    text-style: bold;
    margin: 1 0 0 0;
    width: 1fr;
    border-bottom: solid $panel;
}
.note { margin: 1 0; }

#commands {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
    border: round $panel;
}

Collapsible { margin: 1 0 0 0; }

.argfield { height: auto; margin: 1 0 0 0; }
.argfield .arg-heading { height: 1; }
.argfield .arg-desc {
    color: $text-muted;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.argfield .arg-error { height: auto; }
.argfield Input, .argfield Select { width: 1fr; }
.argfield SelectionList { height: auto; max-height: 10; }
.argfield TextArea { height: 5; }
.argfield.-invalid Input,
.argfield.-invalid Select > SelectCurrent,
.argfield.-invalid TextArea,
.argfield.-invalid SelectionList { border: tall $error; }
.path-row { height: auto; }
.path-row Input { width: 1fr; }
.path-row .browse { width: auto; min-width: 10; margin: 1 0 0 1; }
.swatch { width: 6; height: 3; margin-left: 1; border: tall $panel; }

#group-errors { height: auto; margin-top: 1; }
#runbar { height: auto; margin: 1 0 1 0; }
#runbar Button { margin-right: 2; }
#runbar Switch { margin-left: 2; }
#debug-label { margin-top: 1; }

#output {
    height: 45%;
    border-top: tall $primary;
}
#output-title { padding: 0 2; height: 1; }
#log { height: 1fr; padding: 0 1; background: $surface; }

BrowseScreen { align: center middle; }
#browse-dialog {
    width: 80%;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $primary;
}
#browse-tree { height: 1fr; margin: 1 0; }
#browse-buttons { height: auto; }
#browse-buttons Button { margin-right: 2; }
